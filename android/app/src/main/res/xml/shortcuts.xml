<?xml version="1.0" encoding="utf-8"?>
<!-- Atalhos ao segurar o ícone do app (dá para arrastar para a tela inicial). Os documentos recentes entram pelo código. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="escanear"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_scan"
        android:shortcutShortLabel="@string/sc_scan"
        android:shortcutLongLabel="@string/sc_scan_long">
        <intent
            android:action="io.github.lohanlilson.lumenpdf.ESCANEAR"
            android:targetPackage="io.github.lohanlilson.lumenpdf"
            android:targetClass="io.github.lohanlilson.lumenpdf.MainActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="abrir"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_open"
        android:shortcutShortLabel="@string/sc_open"
        android:shortcutLongLabel="@string/sc_open_long">
        <intent
            android:action="io.github.lohanlilson.lumenpdf.ABRIR"
            android:targetPackage="io.github.lohanlilson.lumenpdf"
            android:targetClass="io.github.lohanlilson.lumenpdf.MainActivity" />
    </shortcut>
</shortcuts>
